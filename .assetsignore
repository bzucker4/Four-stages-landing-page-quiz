# Excludes dev/build tooling and the Worker source from being deployed as
# public static assets by Cloudflare Workers (assets directory = repo root,
# see wrangler.jsonc). Gitignore syntax. src/ is bundled into the Worker
# script by wrangler separately — it must not also be served as a static
# file (e.g. GET /src/worker.ts).
node_modules/
src/
scripts/
package.json
package-lock.json
tsconfig.json
wrangler.jsonc
.gitignore
.assetsignore
.git/
