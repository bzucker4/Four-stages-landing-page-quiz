# Cloudflare Pages custom headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# HTML pages: browsers always revalidate (max-age=0), but Cloudflare's edge
# cache holds a copy for a day and serves it stale while it refetches in the
# background (s-maxage + stale-while-revalidate are standard HTTP directives,
# not Netlify-specific, so this works the same on Cloudflare's CDN).
/
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=86400

/index.html
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=86400

/quiz/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=86400

# Static assets: cached for a year and treated as immutable. Safe only
# because the CSS link tags carry a ?v= cache-busting query string (see
# css/style.css) — bump that version whenever style.css changes. Images
# added later under /images/ should use content-hashed or versioned
# filenames/query strings for the same reason.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable
